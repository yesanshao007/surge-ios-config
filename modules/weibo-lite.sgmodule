#!name=微博轻量去广告
#!desc=拒绝明确广告接口，并仅从首页/关注时间线移除带明确广告标记的条目
#!author=yesanshao007
#!requirement=SYSTEM = 'iOS'

[URL Rewrite]
^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkconfig\.php(?:\?|$) - reject
^https?:\/\/(?:preload-click|preload-impression)\.uve\.weibo\.com\/(?:interface\/wbpullad\/wbpullad_click\.php|wbapplua\/get_wbpullad_log\.lua)(?:\?|$) - reject
^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?(?:[^#]*&)?a=get_coopen_ads(?:&|$) - reject
^https?:\/\/tqt\.weibo\.cn\/overall\/redirect\.php\?.*(?:r=tqtad|tqt_sdkad) - reject
^https?:\/\/tqt\.weibo\.cn\/api\/advert\/ - reject
^https?:\/\/tqt\.weibo\.cn\/.+advert\.index - reject

[Script]
weibo-feed-clean = type=http-response, pattern=^https?:\/\/m?api\.weibo\.(?:cn|com)\/\d+\/(?:statuses\/(?:friends\/timeline|unread_friends(?:\/|_)timeline|unread_hot_timeline)|groups\/timeline)(?:\?|$), requires-body=true, max-size=3145728, timeout=5, script-path=https://raw.githubusercontent.com/yesanshao007/surge-ios-config/main/scripts/weibo-feed-clean.js

[MITM]
hostname = %APPEND% sdkapp.uve.weibo.com, preload-click.uve.weibo.com, preload-impression.uve.weibo.com, weibointl.api.weibo.cn, tqt.weibo.cn, api.weibo.cn, api.weibo.com, mapi.weibo.cn, mapi.weibo.com
