#!name=常用 App 去开屏（保守版）
#!desc=10 款按需使用的 App 开屏候选接口；大麦仅处理历史欢迎页接口
#!author=yesanshao007
#!requirement=SYSTEM = 'iOS'

# Historical candidates: ddgksf2013 StartUpAds.conf, via the 2026-08-29
# Walvez/surge-startup-ads conversion. Patterns below were narrowed and
# rewritten for this module; current app behavior still needs device checks.
# Do not enable together with the broad StartUpAds/Script Hub module.

[URL Rewrite]
# 拼多多: splash resource only
^https?:\/\/api\.(?:pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash(?:\/|\?|$) _ reject
# 淘宝: home splash resource only
^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get(?:\/|\?|$) _ reject

[Map Local]
# Preserve Script Hub's conversion of QX reject-200: HTTP 200 with one space.
# 大麦: historical welcome-page method only; exclude the separate popup method.
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.welcome(?:\/|\?|$) data-type=text data=" " status-code=200
# 飞猪: historical Fliggy CRM splash endpoints only; current app traffic unverified.
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.allresource(?:\/|\?|$) data-type=text data=" " status-code=200
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.availablesplashstrategies(?:\/|\?|$) data-type=text data=" " status-code=200
# 闲鱼: historical splash.ads plus newer async/g-acs variants.
^https?:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop.*splash\.(?:async\.)?ads data-type=text data=" " status-code=200
# Jump 游戏玩家社区: restore both historical branches, including ad_conf.
^https?:\/\/switch\.jumpvg\.com\/jump\/(getlaunchad|recommend\/ad_conf) data-type=text data=" " status-code=200
# 航旅纵横: historical startup hosts and native endpoint only.
^https?:\/\/(?:discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native(?:\?|$) data-type=text data=" " status-code=200

[Script]
# 12306: request body identifies the two historical splash placements.
railway12306-splash-clean = type=http-request, pattern=^https?:\/\/ad\.12306\.cn\/ad\/ser\/getAdList(?:\?|$), requires-body=true, max-size=65536, timeout=5, script-path=https://raw.githubusercontent.com/yesanshao007/surge-ios-config/main/scripts/12306-splash-clean.js
# Cainiao: preserve non-splash ads and the response envelope.
cainiao-splash-clean = type=http-response, pattern=^https?:\/\/netflow-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.show\.cn(?:\/|\?|$), requires-body=true, max-size=524288, timeout=5, script-path=https://raw.githubusercontent.com/yesanshao007/surge-ios-config/main/scripts/cainiao-splash-clean.js
# JD: only adjust marked startup images; keep the rest of the start response.
jd-splash-clean = type=http-response, pattern=^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=start(?:&|$), requires-body=true, max-size=1048576, timeout=5, script-path=https://raw.githubusercontent.com/yesanshao007/surge-ios-config/main/scripts/jd-splash-clean.js

[MITM]
hostname = %APPEND% netflow-mtop.cainiao.com, api.pinduoduo.com, api.yangkeduo.com, guide-acs.m.taobao.com, acs.m.taobao.com, acs.m.goofish.com, g-acs.m.goofish.com, switch.jumpvg.com, api.m.jd.com, ad.12306.cn, discardrp.umetrip.com, startup.umetrip.com
